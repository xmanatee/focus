{
  "expo": {
    "name": "Focus Blocks",
    "slug": "focus-blocks",
    "version": "1.0.7",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "love.nemi.focus",
      "appStoreUrl": "https://apps.apple.com/app/id6763754394",
      "appleTeamId": "569HBLNQPC",
      "buildNumber": "17",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["focusblocks", "device-activity"]
          }
        ],
        "NSFamilyControlsUsageDescription": "Focus Blocks uses Screen Time to block the apps you choose during the schedules you create.",
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown"
        ]
      }
    },
    "scheme": "focusblocks",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F2E8",
          "image": "./assets/icon.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#1A1510",
            "image": "./assets/icon.png"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.0"
          }
        }
      ],
      [
        "react-native-device-activity",
        {
          "appleTeamId": "569HBLNQPC",
          "appGroup": "group.love.nemi.focus",
          "copyToTargetFolder": false
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/with-focusblocks-icloud",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "love.nemi.focus",
      "versionCode": 17,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F2E8"
      }
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "love.nemi.focus.ShieldConfiguration",
                  "targetName": "ShieldConfiguration",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.love.nemi.focus"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "love.nemi.focus.ShieldAction",
                  "targetName": "ShieldAction",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.love.nemi.focus"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "love.nemi.focus.ActivityMonitorExtension",
                  "targetName": "ActivityMonitorExtension",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.love.nemi.focus"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "2d1c3dbd-6c6d-4d6c-8dfa-edb6681c54f8"
      }
    },
    "owner": "xmanatee"
  }
}
