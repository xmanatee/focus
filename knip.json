{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "scripts/**/*.{js,mjs}",
    "src/**/*.android.{ts,tsx}",
    "src/**/*.ios.{ts,tsx}",
    "babel.config.js",
    "metro.config.js",
    "plugins/*.js",
    "store.config.js",
    "targets/**/expo-target.config.js"
  ],
  "ignoreFiles": ["site/*.css"],
  "ignoreDependencies": ["chalk"],
  "ignoreIssues": {
    "app.json": ["unlisted"]
  },
  "treatConfigHintsAsErrors": false
}
