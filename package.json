{
  "name": "focus-blocks",
  "version": "1.0.10",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node scripts/expo.mjs start",
    "build": "node scripts/expo.mjs export --platform android --platform ios --output-dir dist",
    "deploy": "python3 .release/deploy.py",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --apply .",
    "format": "biome format . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run check-lines && npm run check-antipatterns && npm run check-native && npm run check-release && npm run check-unused && npm test",
    "check:all": "npm run check && npm run build && npm run android:verify",
    "check-antipatterns": "node scripts/check-antipatterns.mjs",
    "check-deps": "npm ls",
    "check-lines": "node scripts/check-line-limit.mjs",
    "check-native": "node scripts/check-native-structure.mjs",
    "check-release": "node scripts/check-release-distribution.mjs",
    "check-unused": "knip --no-config-hints",
    "android": "node scripts/expo.mjs run:android",
    "android:verify": "cd android && NODE_ENV=production ./gradlew :app:lintRelease :app:testReleaseUnitTest :app:assembleDebug -x :react-native-reanimated:lintAnalyzeRelease -x :react-native-worklets:lintAnalyzeRelease",
    "eas-build-post-install": "node scripts/sync-ios-versions.mjs",
    "ios": "node scripts/expo.mjs run:ios",
    "screenshots": "node scripts/screenshots.mjs",
    "sync-ios-versions": "node scripts/sync-ios-versions.mjs"
  },
  "dependencies": {
    "@nauverse/expo-cloud-settings": "^1.3.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "chalk": "4.1.2",
    "expo": "~57.0.17",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-store-review": "~57.0.2",
    "expo-symbols": "~57.0.2",
    "nativewind": "^4.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.6",
    "react-native-device-activity": "^0.6.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.7.3",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/react": "~19.2.14",
    "babel-preset-expo": "~57.0.0",
    "knip": "^5.12.1",
    "lefthook": "^1.6.10",
    "sharp": "0.35.3",
    "tailwindcss": "^3.4.1",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "vitest": "3.2.6"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": ["@nauverse/expo-cloud-settings"]
      }
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "overrides": {
    "@bacons/xcode": "1.0.0-alpha.33",
    "@expo/plist": "0.8.1",
    "glob": "13.0.6",
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "uuid": "11.1.1"
  }
}
